# Copy this file to .env and set your values

# Global settings 

BLOOMIN8_MAC=AA:11:BB:22:CC:33
BLOOMIN8_IP=192.168.10.10
# Comma-separated gallery allowlist for `show --gallery` and to 
# identify when a displayed image is from a gallery that should not be backed up
BLOOMIN8_MANAGED_GALLERIES=temp,media,games,music
# Gallery to use when using the CLI without specifying a gallery
# BLOOMIN8_GALLERY=temp
# Optional: resize mode for the image (defaults: cover)
BLOOMIN8_DISPLAY_MODE=cover
# Optional experimental e-ink post-processing preset: off, 1
BLOOMIN8_PYTHON_EINK_PRESET=off
# If the frame is already busy, do not proceed with the action instead of queuing it.
BLOOMIN8_ONLY_IF_IDLE=false
# Enable verbose HTTP request stack logs (requests/httpx/httpcore). Default is false.
BLOOMIN8_PYTHON_DEBUG_REQUESTS=false


# Webhook settings

WEBHOOK_PLEX_SERVER_URL=https://your-plex-server:32400
# See https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
WEBHOOK_PLEX_TOKEN=your-plex-token
# Skip processing when the webhook's Account.owner is false
WEBHOOK_PROCESS_OWNER_PLAYBACK_ONLY=true
# Skip processing when the webhook's Player.local is false
WEBHOOK_PROCESS_LOCAL_PLAYBACK_ONLY=true
# Comma-separated Plex media types to process: movie, episode, track.
WEBHOOK_LISTEN_FOR_PLEX_MEDIA_TYPES=movie,episode
# Restore the previous image after Plex sends a media.stop event. Also sets WEBHOOK_DEFAULT_OVERWRITE_STATE=true
WEBHOOK_LISTEN_FOR_PLEX_STOP=true
# Let the Plex webhook take over a frame showing an image it did not put there,
# overwriting any pending restoration state
WEBHOOK_DEFAULT_OVERWRITE_STATE=false
# Same as BLOOMIN8_ONLY_IF_IDLE, but only for webhook-driven actions
WEBHOOK_ACTION_ONLY_IF_IDLE=true
#Number of seconds to wait after a stop event before sending the restore command . 
# This allows for a brief change of playback item without triggering a restore. 
# A new play during this window will skip the restore and show the next poster.
WEBHOOK_RESTORE_DEBOUNCE_SECONDS=20
# Number of seconds to wait before sending an image to the frame.
# Skipping through media within this window replaces the pending image instead of
# sending a slow wake and upload per event.
WEBHOOK_SHOW_DEBOUNCE_SECONDS=5
